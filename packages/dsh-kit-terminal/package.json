{
  "name": "dsh-kit-terminal",
  "version": "0.5.3-alpha.2",
  "description": "dsh-kit 终端组件：输入行终端入口与底部多标签终端坞（引擎为官方 webTerminals）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./client/bundle.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "client",
    "locale"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "dsh-kit-core": "workspace:*"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "dsh-kit"
      ]
    }
  }
}

{
  "name": "dsh-kit-monitor",
  "version": "0.5.3-alpha.2",
  "description": "dsh-kit 用量与监视组件：/dsh-kit/usage 聚合端点（provider 发现 + 三家上游）+ 余额用量芯片（UsageLine），usageEnabled 总开关门控",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "client"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "dsh-kit-core": "workspace:*"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "dsh-kit-dock"
      ]
    }
  }
}
